<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Best practice: Declaring <memory-budget> in AndroidManifest.xml is the primary and
      recommended way to define app memory budgets on Android 17 QPR2 (API 37.2) and higher.

      Important guidelines:
      1. Apply <memory-budget> only in release (optimized) builds (e.g., src/release/AndroidManifest.xml)
         so unoptimized debug instrumentation and tests do not experience swap churn.
      2. Order clauses from general to specific because the LAST applicable clause takes effect.
      3. It is intentionally omitted from the merged debug/sample catalog manifest below so it
         does not constrain unrelated samples in the Platform Samples host app:

      <application>
          <!- - General baseline budget for foreground UI with density scaling - ->
          <memory-budget
              android:maxMb="256"
              android:additionalMbPerDensity="16" />

          <!- - Tighter budget when perceptible without a visible window (e.g., audio playback) - ->
          <memory-budget
              android:maxMb="120"
              android:state="perceptible" />

          <!- - Minimal budget when fully in the background - ->
          <memory-budget
              android:maxMb="48"
              android:state="background" />

          <!- - Wear OS override placed last so it overrides the general baseline on watches - ->
          <memory-budget
              android:maxMb="48"
              android:feature="watch" />
      </application>
    -->
</manifest>
